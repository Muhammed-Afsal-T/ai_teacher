# Groq API Key (Sign up for free at https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=True

# SQLite Database
DATABASE_URL=sqlite:///./ai_teacher.db

# Audio Storage & Cleanup Settings
AUDIO_STORAGE_PATH=./static/audio
AUDIO_RETENTION_SECONDS=3600
CLEANUP_INTERVAL_SECONDS=600

# Edge TTS Default Voice (Supported: en-US-ChristopherNeural, en-US-GuyNeural, en-IN-PrabhatNeural, ml-IN-MidhunNeural)
TTS_DEFAULT_VOICE=en-US-ChristopherNeural
TTS_MALAYALAM_VOICE=ml-IN-MidhunNeural
